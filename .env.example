# Sample only. Provision strong secrets and scrypt hash in root-owned mode-0600 VPS env.
# NEVER commit passwords, hashes, tokens, private keys, OAuth JSON or cookies.
CONCAT_WEB_HOST=127.0.0.1
CONCAT_WEB_PORT=18873
CONCAT_WEB_PUBLIC_ORIGIN=https://concat.scenebuilder.online
CONCAT_WEB_DATA_ROOT=/var/lib/concat-web

# Explicit personal admin mode; no Scene issuer or users DB dependency.
CONCAT_AUTH_MODE=local
CONCAT_LOCAL_ADMIN_USERNAME=
CONCAT_LOCAL_ADMIN_PASSWORD_HASH=
CONCAT_LOCAL_SESSION_SECRET=
CONCAT_WEB_SECURITY_DB=/var/lib/concat-web/security.sqlite3

# Private owner-scoped uploader and verified Concat media handoff.
CONCAT_UPLOADER_ENABLED=1
LUM_DATA_DIR=/var/lib/concat-web/uploader
LUM_SESSION_SECRET=
CONCAT_CLOUD_RENDER_ROOT=/var/lib/concat-web
CONCAT_PUBLIC_ORIGIN=https://concat.scenebuilder.online

# Gateway enforces LUM_ENGINE_INSTANCE=concat, LUM_BASE_PATH=/concat-uploader,
# LUM_SUITE_AUTH=1, LUM_COOKIE_SECURE=1, CONCAT_WEB_IN_PROCESS=1.
# Never expose the reused uploader over an alternate port.
